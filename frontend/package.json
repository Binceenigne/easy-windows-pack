{
  "name": "easy-windows-pack-workspace",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22.12.0" },
  "workspaces": ["packages/*"],
  "scripts": {
    "ewp": "node packages/easywindowspack/bin/ewp.mjs",
    "help": "node packages/easywindowspack/bin/ewp.mjs help",
    "menu": "node packages/easywindowspack/bin/ewp.mjs menu",
    "info": "node packages/easywindowspack/bin/ewp.mjs info",
    "init": "node packages/easywindowspack/bin/ewp.mjs init",
    "dev": "npm run prepare:npm && node packages/easywindowspack/bin/ewp.mjs dev",
    "browser": "npm run prepare:npm && node packages/easywindowspack/bin/ewp.mjs browser",
    "frontend": "npm run prepare:npm && node packages/easywindowspack/bin/ewp.mjs frontend",
    "demo": "node packages/easywindowspack/bin/ewp.mjs demo",
    "wheel": "node packages/easywindowspack/bin/ewp.mjs wheel",
    "exe": "node packages/easywindowspack/bin/ewp.mjs exe",
    "build": "node packages/easywindowspack/bin/ewp.mjs build",
    "build:all": "node packages/easywindowspack/bin/ewp.mjs build:all",
    "full-build": "node packages/easywindowspack/bin/ewp.mjs full-build",
    "build:wheel": "node packages/easywindowspack/bin/ewp.mjs wheel",
    "build:exe": "node packages/easywindowspack/bin/ewp.mjs exe",
    "app": "node packages/easywindowspack/bin/ewp.mjs app",
    "build:app": "node packages/easywindowspack/bin/ewp.mjs app",
    "installer": "node packages/easywindowspack/bin/ewp.mjs installer",
    "bundle": "node packages/easywindowspack/bin/ewp.mjs bundle",
    "test": "node packages/easywindowspack/bin/ewp.mjs test",
    "test:npm": "npm run prepare:npm && node --test ../tests/npm-runtime.test.mjs ../tests/create-ewp.test.mjs",
    "test:pack": "node ../tests/npm-pack.integration.mjs",
    "pack:npm": "npm run prepare:npm && npm pack --workspaces --pack-destination ../output/npm",
    "prepare:npm": "node ../scripts/prepare-npm.mjs",
    "frontend:dev": "npm run prepare:npm && node packages/easywindowspack/bin/ewp.mjs frontend:dev",
    "frontend:build": "npm run prepare:npm && node packages/easywindowspack/bin/ewp.mjs frontend:build",
    "frontend:preview": "node packages/easywindowspack/bin/ewp.mjs frontend:preview",
    "check": "node packages/easywindowspack/bin/ewp.mjs check",
    "prepack": "npm run prepare:npm"
  },
  "dependencies": { "easywindowspack": "0.1.2" },
  "devDependencies": { "vite": "^7.3.7" }
}