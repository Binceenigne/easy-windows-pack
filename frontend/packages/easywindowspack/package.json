{
  "name": "easywindowspack",
  "version": "0.1.1",
  "description": "Shared WebView window frame and development CLI for easy-windows-pack",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22.12.0" },
  "bin": { "ewp": "./bin/ewp.mjs" },
  "exports": {
    ".": { "types": "./index.d.ts", "import": "./index.mjs" },
    "./frame.css": "./assets/window-frame.css",
    "./desktop.css": "./assets/desktop-components.css",
    "./desktop-components.js": "./desktop-components.mjs",
    "./desktop-updates.js": "./desktop-updates.mjs",
    "./vue": "./vue.mjs",
    "./react": "./react.mjs"
  },
  "files": ["assets", "bin", "*.mjs", "*.d.ts", "LICENSE", "README.md"],
  "sideEffects": ["./assets/*.js", "./assets/*.css", "./desktop-components.mjs", "./desktop-updates.mjs"],
  "dependencies": { "vite": "^7.3.7", "create-ewp": "^0.1.1" },
  "scripts": { "prepack": "node ../../../scripts/prepare-npm.mjs" },
  "repository": { "type": "git", "url": "git+https://github.com/Binceenigne/easy-windows-pack.git", "directory": "frontend/packages/easywindowspack" },
  "peerDependencies": { "react": ">=18", "react-dom": ">=18", "vue": ">=3.3" },
  "peerDependenciesMeta": { "react": { "optional": true }, "react-dom": { "optional": true }, "vue": { "optional": true } }
}